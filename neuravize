<script>
const cursor=document.getElementById('cursor'),ring=document.getElementById('cursorRing');
let mx=0,my=0,rx=0,ry=0;
document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;cursor.style.left=mx-3.5+'px';cursor.style.top=my-3.5+'px'});
(function animRing(){rx+=(mx-rx)*0.1;ry+=(my-ry)*0.1;ring.style.left=rx-15+'px';ring.style.top=ry-15+'px';requestAnimationFrame(animRing)})();
document.querySelectorAll('a,button').forEach(el=>{
  el.addEventListener('mouseenter',()=>{cursor.style.transform='scale(2.5)';ring.style.transform='scale(1.6)'});
  el.addEventListener('mouseleave',()=>{cursor.style.transform='scale(1)';ring.style.transform='scale(1)'});
});
const navbar=document.getElementById('navbar');
window.addEventListener('scroll',()=>navbar.classList.toggle('scrolled',scrollY>80));
const obs=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible')})},{threshold:0.1});
document.querySelectorAll('.reveal,.reveal-left,.reveal-right').forEach(el=>obs.observe(el));
function toggleFaq(btn){const item=btn.parentElement,open=item.classList.contains('open');document.querySelectorAll('.faq-item.open').forEach(i=>i.classList.remove('open'));if(!open)item.classList.add('open')}
function toggleProceso(id,btn){const panel=document.getElementById(id),open=panel.classList.contains('active');document.querySelectorAll('.proceso-panel.active').forEach(p=>p.classList.remove('active'));if(!open)panel.classList.add('active')}
function switchCamino(idx,btn){document.querySelectorAll('.camino-tab').forEach(t=>t.classList.remove('active'));document.querySelectorAll('.camino-panel').forEach(p=>p.classList.remove('active'));btn.classList.add('active');document.getElementById('cam-panel-'+idx).classList.add('active')}
window.addEventListener('scroll',()=>{const v=document.getElementById('hero-video');if(v)v.style.transform='translateY('+scrollY*0.28+'px)'});
</script>
